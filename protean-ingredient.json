  "entrypoint": "install.sh",
  "payload": [
    "SPEC.md",
    "skills/sym2p",
    "scripts/protean-sym2p",
    "templates/protean-sym2p",
    "examples/protean-sym2p",
    "AUDIT/protean-sym2p",
    "gates/protean-sym2p"
  ],
  "installTargets": [
    "SPEC.md",
    "skills/sym2p",
    "scripts/protean-sym2p",
    "templates/protean-sym2p",
    "examples/protean-sym2p",
    "AUDIT/protean-sym2p",
    "gates/protean-sym2p"
  ],
  "gates": [
    {
      "name": "internal-names",
